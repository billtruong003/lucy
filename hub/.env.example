# Lucy Hub env. Copy -> .env, đặt TRÊN máy chạy hub. 🔐 không commit.
LUCY_HUB_PASSWORD=          # mật khẩu đăng nhập web (BẮT BUỘC). 2FA bật thêm trong tab Settings.
# LUCY_HUB_PORT=8800
# LUCY_HUB_HOST=0.0.0.0     # nginx: đặt 127.0.0.1 (chỉ nginx proxy vào)

# Engine
# CLAUDE_BIN=claude         # VPS: /root/.local/bin/claude   · Windows: ...\bin\claude.exe
# LUCY_WORKDIR=~/lucy/workspace
# LUCY_PERSONA=~/lucy/bridge/persona.md
# LUCY_CLAUDE_TIMEOUT=900
# LUCY_PROJECTS_ROOT=~/lucy           # gốc tab Projects

# State bền (2FA secret, schedules, log, lịch sử chat). Mặc định ~/.lucy-hub
# LUCY_STATE=~/.lucy-hub

# Schedule
# LUCY_TZ_OFFSET=7                     # múi giờ cho lịch (VN = 7)
# TELEGRAM_BOT_TOKEN=                  # (tuỳ chọn) lịch đẩy kết quả ra Telegram
# LUCY_PUSH_CHAT_ID=                   # chat id nhận push (mặc định = LUCY_ALLOWED_USER_ID)

# Aki (radiant-bot Discord) — tab Aki: đẩy báo cáo / tạo kênh qua Aki (ký HMAC)
# RADIANT_BOT_API_URL=http://127.0.0.1:3030   # nơi radiant-bot phục vụ (HEALTH_PORT > 0)
# RADIANT_BOT_AGENT_SECRET=                    # = AGENT_HMAC_SECRET bên radiant-bot (openssl rand -hex 32)

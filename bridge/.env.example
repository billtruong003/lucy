# Bridge Telegram: bot token, user được phép, persona, Claude CLI
# Copy thành bridge/.env rồi điền giá trị. KHÔNG commit file thật.
TELEGRAM_BOT_TOKEN=
LUCY_ALLOWED_USER_ID=
CLAUDE_BIN=/root/.local/bin/claude
LUCY_WORKDIR=/root/lucy-workspace
LUCY_PERSONA=/root/lucy/bridge/persona.md
LUCY_CLAUDE_TIMEOUT=900
RADIANT_BOT_API_URL=
RADIANT_BOT_AGENT_SECRET=
LUCY_BRIEF_DISCORD_CHANNEL=
LUCY_TECH_DISCORD_CHANNEL=
LUCY_TECH_DISCORD_THREAD=
LUCY_TG_PROXY=
LUCY_SESSION_SUMMARY=1
ANTHROPIC_BASE_URL=http://127.0.0.1:47821
AM_TOKEN=

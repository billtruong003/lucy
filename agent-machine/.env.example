# Agent-machine (coordinator/worker): token nội bộ, ngân sách, concurrency
# Copy thành agent-machine/.env rồi điền giá trị. KHÔNG commit file thật.
AM_TOKEN=
AM_PORT=8780
AM_DATA=/root/.agent-machine
AM_CAP_USD=9999
AM_WEEKLY_CAP_USD=9999
AM_PER_CARD_USD=9999
AM_CARD_HARD_USD=9999
AM_MAX_LANES=1
AM_WORKER_CONCURRENCY=1
AM_LEASE_MS=3000000
LUCY_SESSION_SUMMARY=1
